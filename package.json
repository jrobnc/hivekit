{
  "name": "hivekit",
  "version": "1.0.0",
  "description": "Declare what done means — hivekit builds until it's true. Reference compiler for HIVE.md (intent-as-source for AI agents)",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "dist/",
    "plugins/",
    "docs/"
  ],
  "exports": {
    "./intent": {
      "types": "./dist/intent.d.ts",
      "import": "./dist/intent.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "bin": {
    "hivekit": "./bin/hivekit",
    "harness": "./bin/harness"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/prompts && cp -r src/prompts dist/prompts",
    "prepare": "npm run build",
    "test": "npm run build && HIVEKIT_LEDGER=\"${TMPDIR:-/tmp}/hivekit-test-ledger-$$.jsonl\" node --experimental-test-module-mocks --test test/*.test.mjs",
    "test:packaged": "npm run build && node --test test/network/*.test.mjs",
    "dev": "env -u ANTHROPIC_API_KEY tsx src/index.ts",
    "start": "env -u ANTHROPIC_API_KEY node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.292",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
