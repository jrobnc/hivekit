#!/usr/bin/env bash
# Back-compat alias — the canonical entrypoint is now `bin/hivekit`.
# Existing wiring (slash commands, launchers) that calls `bin/harness` keeps working.

# Resolve this script through any symlinks before locating its sibling launcher.
# `npm install` links node_modules/.bin/harness -> ../hivekit/bin/harness, so
# `dirname "$0"` alone points at node_modules/.bin. Walk the symlink chain by
# hand: `readlink -f` is GNU-only and is not available on macOS.
resolve_script_dir() {
  local target="$1" link_dir
  while [ -L "$target" ]; do
    link_dir="$(cd -P "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    case "$target" in
      /*) ;;
      *) target="$link_dir/$target" ;;
    esac
  done
  (cd -P "$(dirname "$target")" && pwd)
}

exec "$(resolve_script_dir "${BASH_SOURCE[0]}")/hivekit" "$@"
