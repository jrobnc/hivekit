#!/usr/bin/env bash
# Harness launcher — strips ANTHROPIC_API_KEY and ANTHROPIC_AUTH_TOKEN BEFORE Node starts so the
# Agent SDK can't resolve to metered API billing. The OAuth (Claude Max)
# path is then the only credential available, matching the intended billing
# model. To opt out for a specific run, set HARNESS_ALLOW_API_KEY=1.
#
# Also strips the parent's Claude Code session env vars (CLAUDECODE,
# CLAUDE_CODE_SESSION_ID, etc.) before exec'ing Node. When bin/hivekit is
# invoked from inside an already-running Claude Code session (e.g. via its
# Bash tool), those vars otherwise leak into the `claude` subprocess the
# Agent SDK spawns for the Planner/Generator/Evaluator, and that subprocess
# crashes on startup with "Claude Code process exited with code 1" — it
# tries to attach to a session that isn't its own. CLAUDE_CODE_OAUTH_TOKEN
# is deliberately NOT in this list; that's the auth credential the
# subprocess needs.
set -euo pipefail

# Resolve this script through any symlinks before deriving the package root.
# `npm install` links node_modules/.bin/hivekit -> ../hivekit/bin/hivekit, so
# `dirname "$0"` alone points at node_modules/.bin and dist/ is looked for in
# the wrong place. Walk the symlink chain by hand: `readlink -f` is GNU-only
# and is not available on macOS. The walk is capped at MAX_SYMLINK_HOPS so a
# malformed or cyclic link chain fails fast instead of spinning forever. 20 is
# far more hops than any real npm/pnpm layout needs (one or two), and below the
# OS's own ELOOP cap.
MAX_SYMLINK_HOPS=20

resolve_script_dir() {
  local target="$1" link_dir hops=0
  while [ -L "$target" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt "$MAX_SYMLINK_HOPS" ]; then
      echo "[hivekit] ERROR: more than $MAX_SYMLINK_HOPS symlinks while resolving launcher path '$1' (cyclic or malformed symlink?)" >&2
      return 1
    fi
    link_dir="$(cd -P "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    case "$target" in
      /*) ;;
      *) target="$link_dir/$target" ;;
    esac
  done
  (cd -P "$(dirname "$target")" && pwd)
}

SCRIPT_DIR="$(resolve_script_dir "${BASH_SOURCE[0]}")" || exit 1
ENTRY="$SCRIPT_DIR/../dist/index.js"

NESTED_SESSION_VARS=(
  CLAUDECODE
  CLAUDE_CODE_ENTRYPOINT
  CLAUDE_CODE_EXECPATH
  CLAUDE_CODE_SESSION_ID
  CLAUDE_CODE_CHILD_SESSION
  CLAUDE_EFFORT
  ANTHROPIC_MODEL
  AI_AGENT
)
UNSET_ARGS=()
for name in "${NESTED_SESSION_VARS[@]}"; do
  UNSET_ARGS+=(-u "$name")
done

# Auth for the Planner/Generator/Evaluator subprocesses. If the caller did not set
# CLAUDE_CODE_OAUTH_TOKEN, read the CURRENT access token from the macOS Keychain at
# launch. (A shell-wide export, the old ~/.zshenv approach, froze a token that
# expires in hours and forced /login on every Claude Code session.) An explicitly
# set variable is a deliberate override (CI, tests) and is left alone.
# Keychain is read only for the claude provider; other providers must never see the token.
if [[ "${HIVEKIT_PROVIDER:-claude}" == "claude" && -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]] && command -v security >/dev/null 2>&1; then
  fresh_token="$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null \
    | python3 -c "import sys,json; t=json.load(sys.stdin)['claudeAiOauth']['accessToken']; print(t if isinstance(t,str) else '', end='')" 2>/dev/null || true)"
  if [[ -n "$fresh_token" ]]; then
    export CLAUDE_CODE_OAUTH_TOKEN="$fresh_token"
  fi
fi

# Only gated for the claude provider: other providers run no Claude work, but the ANTHROPIC_* strip below always applies.
# Fail fast when no Max OAuth token resolved: without one the Agent SDK can fall back
# to metered API billing or die mid-run. HARNESS_ALLOW_API_KEY is the deliberate
# API-billing override; HIVEKIT_ALLOW_NO_TOKEN is for tests/CI only. A
# ~/.claude/.credentials.json file (Linux/no-Keychain login) also counts as a token source.
if [[ "${HIVEKIT_PROVIDER:-claude}" == "claude" && -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" && -z "${HARNESS_ALLOW_API_KEY:-}" && -z "${HIVEKIT_ALLOW_NO_TOKEN:-}" && ! -f "${HOME:-}/.claude/.credentials.json" ]]; then
  echo "[hivekit] ERROR: no Claude Max OAuth token found (checked CLAUDE_CODE_OAUTH_TOKEN, the macOS Keychain, ~/.claude/.credentials.json). Run \`claude /login\`, or set CLAUDE_CODE_OAUTH_TOKEN. (HIVEKIT_ALLOW_NO_TOKEN=1 skips this check, for tests/CI only.)" >&2
  exit 3
fi

if [[ -n "${HARNESS_ALLOW_API_KEY:-}" ]]; then
  echo "[hivekit] WARNING: HARNESS_ALLOW_API_KEY is set — ANTHROPIC_API_KEY will NOT be stripped. Billing may use metered API key." >&2
  exec env "${UNSET_ARGS[@]}" node "$ENTRY" "$@"
fi

exec env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN "${UNSET_ARGS[@]}" node "$ENTRY" "$@"
